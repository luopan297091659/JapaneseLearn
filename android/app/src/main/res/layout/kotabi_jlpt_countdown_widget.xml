<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jlpt_countdown_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_jlpt_countdown_shell"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/jlpt_countdown_badge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/widget_jlpt_badge"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="JLPT"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/jlpt_countdown_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="39"
        android:textColor="#1F2937"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/jlpt_countdown_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="天后考试"
        android:textColor="#374151"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/jlpt_countdown_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="2026.07.05"
        android:textColor="#6B7280"
        android:textSize="11sp" />
</LinearLayout>
